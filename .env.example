# DevCrew environment variables
# Copy this file to `.env` (or `.env.local`) and fill in the values: cp .env.example .env
# Every key here is read on the server only, except NEXT_PUBLIC_APP_URL. Never commit the real `.env`.
#
# Legend: [required] the app won't work without it
#         [optional] a feature turns off without it (noted next to each key)

# ─── App ────────────────────────────────────────────────────────────────────────
# [required] Where this app is served. Used for OAuth callbacks and job/webhook URLs.
# Local: http://localhost:3000. Background jobs and Switch Trust scans need a public https URL:
# your deployed domain, or a tunnel such as ngrok (https://xxxx.ngrok-free.app) during development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Postgres + Drizzle ORM) ───────────────────────────────────────────
# [required] Any Postgres 14+ database (local, Neon, Supabase, RDS…). Apply the schema with: npm run db:push
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/devcrew

# ─── Auth (hosted Better Auth, Cloudhike Auth service) ───────────────────────────
# [required] Your Auth service project URL and publishable key. Email, Google and GitHub sign-in
# are switched on in the Auth service dashboard, not here.
# Use the exact host the service answers on, with no redirect (for example, to or from www):
# fetch drops the Authorization header on a cross-host redirect, and social sign-in then fails.
AUTH_URL=https://cloudhike.dev/api/auth-service/your-project
AUTH_PUBLISHABLE_KEY=pk_your_publishable_key
# [optional] Admin key from the same dashboard. Not read by the app today; keep it server-only if you add it.
AUTH_SECRET_KEY=sk_your_secret_key

# ─── GitHub OAuth App (links a repository to each workspace) ─────────────────────
# [required] Create at https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:               <NEXT_PUBLIC_APP_URL>
#   Authorization callback URL: <NEXT_PUBLIC_APP_URL>/api/github/callback
# The app requests the scopes `repo read:user`.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# [required] Encrypts GitHub tokens at rest (AES-256-GCM). At least 32 characters.
# Generate with: openssl rand -base64 48
# Changing it invalidates stored tokens, and every user must reconnect GitHub.
TOKEN_ENCRYPTION_KEY=your_random_32_plus_character_secret

# ─── S3-compatible storage (workspace logos) ─────────────────────────────────────
# [required to upload logos] AWS S3, Cloudflare R2, MinIO, etc. Objects stay private and are
# streamed through /api/workspaces/[id]/logo. Built-in workspace icons work without S3.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your_bucket
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# ─── OpenAI (the AI agents) ──────────────────────────────────────────────────────
# [optional, but needed for every AI feature] Runs the Analyst, Developer, Reviewer and Tester on task runs,
# powers "Write with AI" for agent instructions, and answers Switch Trust's red-team prompts.
OPENAI_API_KEY=your_openai_api_key
# [optional] Model override. Defaults to gpt-5-mini.
OPENAI_MODEL=

# ─── Cloudhike Jobs (background jobs) ────────────────────────────────────────────
# [required in production] Cloudhike calls this app's signed /api/jobs/* routes for each step of a task run
# and for Switch Trust scans. Create a Jobs project at https://cloudhike.dev and copy its URL and key.
# The key also verifies the x-cloudhike-signature header on incoming job requests.
# In development without these, task runs execute in the background of `npm run dev` instead.
JOBS_API_URL=https://cloudhike.dev/api/jobs-service/your-project
JOBS_API_KEY=your_jobs_api_key

# ─── Switch Trust (agent trust score and ROI) ────────────────────────────────────
# Nothing to set here. Each workspace adds its own Switch Trust API key on the AI Team page
# (stored encrypted). Scans also need OPENAI_API_KEY, Cloudhike Jobs and a public https NEXT_PUBLIC_APP_URL.
# Docs: https://docs.switchagents.ai
